# Supabase — copy this file to `.env` and fill in your project's values.
# Dashboard → Project Settings → API
#
# Both are safe to expose in the client bundle: the publishable key only grants
# what the Row Level Security policies in supabase/schema.sql allow (insert into
# `applications`, and nothing else).
#
# The key below MUST be the publishable one — it starts `sb_publishable_` (or,
# on older projects, the legacy anon JWT starting `eyJ`). Never use the
# `sb_secret_` key or the legacy service_role JWT: they bypass RLS entirely, and
# because every VITE_-prefixed value is compiled into the public JavaScript
# bundle, shipping one would let anyone read and edit the whole applicant list.

VITE_SUPABASE_URL=https://xexhvxjmbsvtyezczjui.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_IMKtXFQfeUk39SWSobI76A_m4m4zVMb

# ─────────────────────────────────────────────────────────────────────────────
# Resend — the contact form on / and /contact
# ─────────────────────────────────────────────────────────────────────────────
#
# Note the missing VITE_ prefix on all three, and keep it that way. These are
# read by api/contact.js, which runs on the server; a VITE_-prefixed name would
# be compiled into the public JavaScript bundle instead, and a leaked sending key
# lets anyone on the internet send mail as the club.
#
# The key comes from resend.com → API Keys. Create the Resend account with the
# CONTACT_TO_EMAIL address below: until a domain is verified, Resend's shared
# sender only delivers to the address that owns the account.
#
# Without RESEND_API_KEY set, the form still renders and validates but tells the
# visitor to email the club directly rather than pretending to have sent.

RESEND_API_KEY=re_4KyyohmH_4dGNgsdXyGK7H8ncTtwDVFkr

# Where messages are delivered. Both of these have the same defaults baked into
# api/contact.js, so they only need setting to change them.
CONTACT_TO_EMAIL=aiclubkiet@gmail.com

# Must be an address on a domain verified in Resend. Leave it on the shared
# sandbox sender until the club has one.
CONTACT_FROM_EMAIL=AI Club KIET <onboarding@resend.dev>

